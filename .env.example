# FactumAI website, omgevingsvariabelen.
#
# Kopieer naar .env.local voor lokaal werk, of zet ze in Vercel. Niets hier is
# geheim: vul de echte waarden nooit in dit bestand in.
#
# Zonder alle optionele variabelen werkt de site gewoon; de betrokken functie
# degradeert dan netjes (opslag wordt overgeslagen, mail wordt niet verstuurd).

# ---------------------------------------------------------------------------
# Algemeen
# ---------------------------------------------------------------------------

# Canonieke URL van de site. Wordt gebruikt voor metadata, sitemap en OG-kaarten.
NEXT_PUBLIC_SITE_URL=https://factumai.nl

# ---------------------------------------------------------------------------
# Anthropic
# ---------------------------------------------------------------------------

# Verplicht voor de AI-scan (/scan) en voor de site-agent.
ANTHROPIC_API_KEY=

# Model-override voor de publieke scan. Default: claude-sonnet-5
SCAN_AI_MODEL=

# ---------------------------------------------------------------------------
# Dashboard-database (Supabase)
# ---------------------------------------------------------------------------

# Zonder deze twee slaat de scan geen leads op en werkt de site-agent niet:
# die haalt zijn berichtgeschiedenis uit de database.
# De service-role key omzeilt RLS en mag nooit naar de client lekken.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Site-agent (de chat rechtsonder)
# ---------------------------------------------------------------------------

# Aan/uit. De agent staat aan; deze twee zijn de noodrem.
#
# SITE_AGENT_ENABLED=false weigert het endpoint direct, ook zonder nieuwe build.
# Dat is de knop die je omzet als de kosten of de kwaliteit uit de hand lopen.
#
# NEXT_PUBLIC_SITE_AGENT_ENABLED=false haalt de widget weg, maar die waarde
# wordt bij de build in de bundel gebakken: er moet een nieuwe deploy overheen
# voordat het effect heeft.
SITE_AGENT_ENABLED=
NEXT_PUBLIC_SITE_AGENT_ENABLED=

# Modellen. Defaults: claude-sonnet-5 voor het gesprek, claude-haiku-4-5 voor
# de scoring na afloop.
SITE_AGENT_MODEL=
SITE_AGENT_SCORE_MODEL=

# Organisatie en agent-rij in de dashboard-database. Defaults:
# org_factumai_internal en cmsiteagent0000factumainl.
SITE_AGENT_ORG_ID=
SITE_AGENT_AGENT_ID=

# Rate limiting. Defaults: 10 berichten per sessie per 10 minuten, 40 per IP per
# uur. Het zout hasht het IP voor de teller; kies iets willekeurigs en houd het
# stabiel, want wijzigen zet alle lopende tellers op nul.
SITE_AGENT_LIMIET_SESSIE=10
SITE_AGENT_LIMIET_IP=40
SITE_AGENT_IP_ZOUT=

# Dagelijks kostenplafond in dollars over alle gesprekken samen. Boven het
# plafond weigert het endpoint nieuwe berichten en verwijst het naar
# info@factumai.nl. Zet op 0 om het plafond uit te zetten. Default: 5.
SITE_AGENT_DAGPLAFOND_USD=5

# Mailbox (instanceKey in het dashboard) waaruit een goedgekeurde procesnotitie
# vertrekt. Laat je dit leeg, dan pakt de orchestrator zijn eigen standaard, en
# die staat op Sjaaks persoonlijke mailbox — dan gaat een mail aan een bezoeker
# vanaf het verkeerde adres de deur uit. Default: default (= "Sales/info mail").
SITE_AGENT_MAILBOX=default

# Tarieven per miljoen tokens, alleen voor de kostenweergave in de werkbak.
# Dit is rapportage en geen facturatie. Defaults: 3 en 15.
SITE_AGENT_PRIJS_INVOER=
SITE_AGENT_PRIJS_UITVOER=

# Waar de escalatiemeldingen naartoe gaan. Default: CONTACT_TO_EMAIL.
SITE_AGENT_NOTIFICATIE_EMAIL=

# Retentie op events in AgentEvent. Default: 180 dagen, gelijk aan de
# RetentionPolicy in het dashboard. Gesprekken zelf staan vast op 90 dagen.
SITE_AGENT_EVENT_RETENTIE_DAGEN=

# ---------------------------------------------------------------------------
# Cron
# ---------------------------------------------------------------------------

# Beschermt /api/v1/site-agent/cron. Zonder deze waarde weigert de route alles.
# Die cron rondt stille gesprekken af en ruimt verlopen data op.
CRON_SECRET=

# ---------------------------------------------------------------------------
# E-mail (Resend)
# ---------------------------------------------------------------------------

# Zonder key wordt er niets gemaild; het contactformulier logt dan naar console.
RESEND_API_KEY=

# Afzender en ontvanger van contact-, scan- en agentmails.
# Defaults: website@factumai.nl en info@factumai.nl.
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# ---------------------------------------------------------------------------
# Agenda (Cal.com)
# ---------------------------------------------------------------------------

# Publieke boekingslink. Default: sjaak-factumai/kennismaking
NEXT_PUBLIC_CAL_LINK=

# Ondertekent de webhook die de bevestigingsmail stuurt. Zonder deze waarde
# weigert /api/cal-webhook alles.
CAL_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Bedrijven-MCP (optioneel, primaire scraper voor de scan)
# ---------------------------------------------------------------------------

# Zonder deze variabelen valt de scan terug op de ingebouwde scraper.
FACTUMAI_MCP_BEDRIJVEN_URL=
FACTUMAI_MCP_INBOUND_SECRET=
FACTUMAI_MCP_ORG_ID=

# Cloudflare Access service-token, alleen bij een MCP op een eigen domein.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Analytics (optioneel, alles na toestemming)
# ---------------------------------------------------------------------------

# GA4-property. Leeg laten zet Google Analytics uit.
NEXT_PUBLIC_GA_ID=

# Google Ads. Zolang deze leeg zijn verschijnt de marketing-categorie niet in
# de cookiebanner en wordt er geen advertentiecookie geplaatst.
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LABEL=

# ---------------------------------------------------------------------------
# Externe contentfeed (optioneel)
# ---------------------------------------------------------------------------

SORO_FEED_URL=
